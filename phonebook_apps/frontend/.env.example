# =============================================================================
# Phonebook frontend environment variables - TEMPLATE
# Copy to frontend/.env.local (git-ignored) for local overrides.
#
# Vite only exposes variables prefixed with VITE_ to client code, and it inlines
# them at build time - never put secrets in a VITE_* variable.
# =============================================================================

# Origin of the API. Leave EMPTY/undefined for normal local development: requests
# then go to the relative path /api and the Vite dev-server proxy (vite.config.js)
# forwards them to http://localhost:8080.
#
# Only UNCOMMENT this to test the local frontend against the deployed backend;
# leaving it enabled would bypass the local proxy. In production the value is
# provided by netlify.toml / the Netlify UI.
VITE_API_BASE_URL=https://phonebook-backend.onrender.com

# Only read by vite.config.js (not exposed to the browser): where the dev-server
# proxy sends /api requests. Useful for pointing `npm run dev` at Render.
API_PROXY_TARGET=http://localhost:8080
