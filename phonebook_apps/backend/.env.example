# =============================================================================
# Backend environment variables - TEMPLATE
# Copy to backend/.env.local (git-ignored) and fill in the real values.
#
#   Local container:  docker run --rm -p 8080:8080 --env-file backend/.env.local phonebook-backend
#   Local jar:        set the variables in your shell, then
#                     java -jar backend/target/phonebook-backend-0.0.1-SNAPSHOT.jar
#
# On Render these are set in the dashboard / render.yaml instead.
# =============================================================================

# Loads application-prod.properties
SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------------------
# Aiven for MySQL  (Console > service > Overview > Connection information)
# Replace every placeholder with the value from the Aiven console. Never commit
# a filled-in copy of this file - it is a template only.
# ---------------------------------------------------------------------------
DB_HOST=mysql-phonebook-01-imperialtslearn-1cbd.g.aivencloud.com
DB_PORT=avnadmin
DB_NAME=phonebook_db
DB_USERNAME=avnadmin
DB_PASSWORD=AVNS_LVyRfkDtTYChsqi7wxB
# REQUIRED = TLS encrypted (default). VERIFY_IDENTITY = TLS + CA verification.
DB_SSL_MODE=REQUIRED
# Only needed for VERIFY_IDENTITY, see backend/certs/README.md
# DB_SSL_EXTRA=&trustCertificateKeyStoreUrl=file:/app/certs/aiven-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit

# ---------------------------------------------------------------------------
# JWT signing secret - generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-base64-encoded-32-byte-minimum-secret
JWT_EXPIRATION_MS=86400000

# ---------------------------------------------------------------------------
# CORS - exact browser origin(s) of the deployed frontend, comma separated,
# no trailing slash. Example: https://contactnest.netlify.app
# ---------------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=https://phonebookapp01.netlify.app

# ---------------------------------------------------------------------------
# Schema / pool / logging (optional, defaults shown)
# ---------------------------------------------------------------------------
# update = let Hibernate create/alter tables, validate = fail if schema drifts
JPA_DDL_AUTO=update
DB_POOL_MAX_SIZE=5
LOG_LEVEL_APP=INFO
# PORT is injected by the platform; defaults to 8080 in the app.
